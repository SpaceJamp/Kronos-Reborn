<Project>

  <!--
  Settings shared by every project in this repository.

  Deliberately few. Each value here is one that a wrong answer produces a subtly broken build
  rather than a compile error, which is why each carries a note.
  -->

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <!--
    Architecture: x64 only, for now.

    KronosRid is the single place the runtime identifier is decided, so the runtime identifier and the
    platform target cannot drift apart. Setting one without the other is not possible, which is the
    mistake that would otherwise produce a binary whose architecture disagrees with the runtime it was
    published for.

    ARM64 was supported and has been taken out again. The indirection is deliberately kept rather
    than collapsed into a literal win-x64: putting it back is then the value below plus an entry in
    RuntimeIdentifiers plus a build step, and nothing else has to be untangled.

    What ARM64 would have meant, kept here because it is the reason it was easy to support and is
    still true if it comes back. The DLLs this program places into game folders - nvngx_dlss.dll,
    nvngx_dlssg.dll and the rest - exist only as x86_64 binaries. Windows on ARM runs x64
    applications under emulation and the games on such a machine are x64 games, so their folders hold
    x64 DLLs which are managed normally. Native ARM64 is a property of the application, not of the
    payloads. The consequence is which runtimes are worth offering there: DLSS is moot, because there
    is no ARM64 DLSS and no NVIDIA GPU on Windows on ARM, while FSR and XeSS do apply.

    Prefer32Bit is set false so an AnyCPU project cannot quietly become 32-bit preferred.
    -->
    <KronosRid Condition="'$(KronosRid)' == ''">win-x64</KronosRid>
    <RuntimeIdentifier>$(KronosRid)</RuntimeIdentifier>
    <PlatformTarget>$(KronosRid.Replace('win-', ''))</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!--
    Every architecture the project supports, for the package lock only.

    Restore is told about every one so the committed packages.lock.json covers every one, which is what
    lets CI restore in locked mode whichever architecture it happens to be building. The lock records
    which runtimes it covers and refuses a restore whose set does not match, so a lock covering only
    one architecture makes another fail with NU1004 rather than quietly re-resolving to something
    unreviewed.

    KronosRid above still chooses the one being built. RuntimeIdentifiers is plural and affects restore
    resolution rather than the build.

    Removing an entry here invalidates the committed lock and CI fails with NU1004 until the lock is
    regenerated and committed. That is the intended failure. Restore with the lock file property
    disabled, once, and commit the result alongside this change.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!--
    Dependency auditing across the whole graph, transitive packages included.

    The default, NuGetAuditMode=direct, only inspects the PackageReference entries in a project file.
    Advisories overwhelmingly arrive through transitive dependencies, so auditing only the direct ones
    misses most of what it exists to catch.

    Audits stay warnings rather than errors on purpose. Turning them into errors would let a
    transitive advisory inside a package that cannot be updated here block every build, and a guard
    that blocks everything gets switched off. They appear in the CI log where they can be read.

    packages.lock.json is committed so that a build resolves to the package versions it was verified
    against, and so the transitive graph is reviewable. Restore in locked mode so that changing a
    PackageReference without committing the updated lock fails loudly instead of quietly rewriting
    it on one machine.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- One place for the version, so the app, the installer and the repository agree. -->
    <Version>0.1.0</Version>

    <!--
    Build metadata injected into the assembly and read back at runtime.

    This has to be a target rather than a bare ItemGroup. A bare ItemGroup is evaluated when the
    project loads, which is before the SDK has run InitializeSourceControlInformation and assigned
    SourceRevisionId, so the commit expands to nothing and is written as an empty string. The
    informational version still shows the commit, because that is assembled much later during
    GenerateAssemblyInfo. Injecting immediately before the assembly attributes are generated is what
    makes it actually work.

    The timestamp is ToString("o") rather than Unix seconds because MSBuild property functions cannot
    call DateTimeOffset.UtcNow.ToUnixTimeSeconds(); that fails the build with MSB4212.

    Branch and tag are not stamped here. MSBuild cannot run git while evaluating properties, so they
    are passed in with -p: by the packaging scripts, and are absent for a plain build. Absence has to
    be handled as normal rather than as an error.
    -->
  </PropertyGroup>

  <Target Name="AddBuildMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="KronosRebornGitBranch" Value="$(GitBranch)" />
      <AssemblyMetadata Include="KronosRebornGitCommit" Value="$(SourceRevisionId)" />
      <AssemblyMetadata Include="KronosRebornGitTag" Value="$(GitTag)" />
      <AssemblyMetadata Include="KronosRebornBuildTimestamp" Value="$([System.DateTime]::UtcNow.ToString(&quot;o&quot;))" />
    </ItemGroup>
  </Target>

</Project>
