# Ignore build output
bin/
obj/

# Packaging output. Regenerated by package\build.cmd; never committed, because an installer in
# version control is a large binary that goes stale and cannot be reviewed in a diff.
package/Output/

# Lock files are deliberately NOT ignored. packages.lock.json is committed so that a build resolves
# to the package versions it was verified against, and so the transitive dependency graph stays
# reviewable. Ignoring them would defeat the point of having them.

# Editor and OS noise
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/
Thumbs.db
Desktop.ini
.DS_Store

# Local logs and scratch
*.log
logs/

# Test output
TestResults/
*.trx
coverage*.xml
coverage*.json
