<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KronosReborn.App"
             RequestedThemeVariant="Default">
    <!-- Default follows the system's light or dark setting, so there is no theme switch to keep. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
