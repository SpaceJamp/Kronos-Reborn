<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:KronosReborn"
        xmlns:vm="using:KronosReborn.UI"
        xmlns:diag="using:KronosReborn.Data.Diagnostics"
        xmlns:log="using:KronosReborn.Data.Logging"
        x:Class="KronosReborn.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Kronos Reborn"
        Icon="/Assets/kronos.ico"
        Classes.magic="{Binding MagicBackground}"
        RequestedThemeVariant="{Binding MagicBackground, Converter={x:Static local:MainWindow.MagicTheme}}"
        Width="1320" Height="820" MinWidth="960" MinHeight="600">

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ListBox.covers">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.covers ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- The magic background: the rings turn and the star swells from code (MainWindow.UpdateMotion),
             which also gates this brightening with the "on" class, so nothing moves while it is off,
             minimised or in the background, or when Windows animations are turned off. -->
        <Style Selector="Panel.magic.on :is(Control).pulse">
            <Style.Animations>
                <Animation Duration="0:0:2.5" IterationCount="INFINITE" Delay="0" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- While it is on, the detail pane and status bar get an opaque backing so text stays readable. -->
        <Style Selector="Border.pane">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Window.magic Border.pane">
            <Setter Property="Background" Value="#F0201440" />
        </Style>
        <Style Selector="Window.magic Border.statusbar">
            <Setter Property="Background" Value="#E60C0624" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- The magic background: the icon's circle, large and faint, turning slowly behind everything. -->
        <Panel x:Name="MagicLayer" Classes="magic" IsVisible="{Binding MagicBackground}"
               IsHitTestVisible="False" ClipToBounds="True">
            <Panel.Background>
                <RadialGradientBrush Center="50%,45%" GradientOrigin="50%,45%" RadiusX="85%" RadiusY="85%">
                    <GradientStop Offset="0" Color="#3A1C78" />
                    <GradientStop Offset="1" Color="#0C0624" />
                </RadialGradientBrush>
            </Panel.Background>
            <Viewbox Stretch="Uniform" Margin="-60">
                <Panel Width="1000" Height="1000">
                    <Canvas x:Name="SpinRing" Width="1000" Height="1000">
                        <Path Stroke="#9670FF" StrokeThickness="18" Opacity="0.05" Data="M 30,500 A 470,470 0 1 1 970,500 A 470,470 0 1 1 30,500 Z M 80,500 A 420,420 0 1 1 920,500 A 420,420 0 1 1 80,500 Z M 500,75 L 500,34 M 717.5,123.3 L 733,96.4 M 876.7,282.5 L 903.6,267 M 925,500 L 966,500 M 876.7,717.5 L 903.6,733 M 717.5,876.7 L 733,903.6 M 500,925 L 500,966 M 282.5,876.7 L 267,903.6 M 123.3,717.5 L 96.4,733 M 75,500 L 34,500 M 123.3,282.5 L 96.4,267 M 282.5,123.3 L 267,96.4" />
                        <Path Stroke="#BEE1FF" StrokeThickness="3" Opacity="0.08" Data="M 30,500 A 470,470 0 1 1 970,500 A 470,470 0 1 1 30,500 Z M 80,500 A 420,420 0 1 1 920,500 A 420,420 0 1 1 80,500 Z M 500,75 L 500,34 M 717.5,123.3 L 733,96.4 M 876.7,282.5 L 903.6,267 M 925,500 L 966,500 M 876.7,717.5 L 903.6,733 M 717.5,876.7 L 733,903.6 M 500,925 L 500,966 M 282.5,876.7 L 267,903.6 M 123.3,717.5 L 96.4,733 M 75,500 L 34,500 M 123.3,282.5 L 96.4,267 M 282.5,123.3 L 267,96.4" />
                        <Path Fill="#BEE1FF" Opacity="0.08" Data="M 615.2,58.2 L 624.2,70.2 L 615.2,82.2 L 606.2,70.2 Z M 808.7,185.3 A 6,6 0 1 1 820.7,185.3 A 6,6 0 1 1 808.7,185.3 Z M 929.8,372.8 L 938.8,384.8 L 929.8,396.8 L 920.8,384.8 Z M 923.8,615.2 A 6,6 0 1 1 935.8,615.2 A 6,6 0 1 1 923.8,615.2 Z M 814.7,802.7 L 823.7,814.7 L 814.7,826.7 L 805.7,814.7 Z M 609.2,929.8 A 6,6 0 1 1 621.2,929.8 A 6,6 0 1 1 609.2,929.8 Z M 384.8,917.8 L 393.8,929.8 L 384.8,941.8 L 375.8,929.8 Z M 179.3,814.7 A 6,6 0 1 1 191.3,814.7 A 6,6 0 1 1 179.3,814.7 Z M 70.2,603.2 L 79.2,615.2 L 70.2,627.2 L 61.2,615.2 Z M 64.2,384.8 A 6,6 0 1 1 76.2,384.8 A 6,6 0 1 1 64.2,384.8 Z M 185.3,173.3 L 194.3,185.3 L 185.3,197.3 L 176.3,185.3 Z M 378.8,70.2 A 6,6 0 1 1 390.8,70.2 A 6,6 0 1 1 378.8,70.2 Z" />
                    </Canvas>
                    <Canvas x:Name="SpinBackRing" Width="1000" Height="1000">
                        <Path Stroke="#9670FF" StrokeThickness="16" Opacity="0.05" Data="M 500,110 L 837.7,695 L 162.3,695 Z M 837.7,305 L 500,890 L 162.3,305 Z M 305,500 A 195,195 0 1 1 695,500 A 195,195 0 1 1 305,500 Z" />
                        <Path Stroke="#BEE1FF" StrokeThickness="3" Opacity="0.08" Data="M 500,110 L 837.7,695 L 162.3,695 Z M 837.7,305 L 500,890 L 162.3,305 Z M 305,500 A 195,195 0 1 1 695,500 A 195,195 0 1 1 305,500 Z" />
                        <Path Fill="#BEE1FF" Opacity="0.08" Data="M 484,110 A 16,16 0 1 1 516,110 A 16,16 0 1 1 484,110 Z M 821.7,305 A 16,16 0 1 1 853.7,305 A 16,16 0 1 1 821.7,305 Z M 821.7,695 A 16,16 0 1 1 853.7,695 A 16,16 0 1 1 821.7,695 Z M 484,890 A 16,16 0 1 1 516,890 A 16,16 0 1 1 484,890 Z M 146.3,695 A 16,16 0 1 1 178.3,695 A 16,16 0 1 1 146.3,695 Z M 146.3,305 A 16,16 0 1 1 178.3,305 A 16,16 0 1 1 146.3,305 Z" />
                    </Canvas>
                    <!-- The star pulses every five seconds: brighter (12% to 30%) and larger (90% to 110%).
                         At rest it sits where a pulse starts, dim and small, so pausing and resuming never jump. -->
                    <Canvas x:Name="StarGlow" Width="1000" Height="1000" Opacity="0.3">
                        <Path Classes="pulse" Opacity="0.4" Fill="#FFECAA" Data="M 500,350 L 524,476 L 650,500 L 524,524 L 500,650 L 476,524 L 350,500 L 476,476 Z" />
                    </Canvas>
                </Panel>
            </Viewbox>
        </Panel>

    <DockPanel>
        <!-- Status bar -->
        <Border Classes="statusbar" DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding StatusText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding Updates.Update.Version, StringFormat='Update to build {0}', FallbackValue=''}"
                            Command="{Binding Updates.InstallCommand}" IsVisible="{Binding Updates.CanInstall}"
                            Classes="accent" Margin="12,0,0,0" Padding="8,2"
                            ToolTip.Tip="Download the new build, then close and install it" />
                    <Button Content="{Binding Updates.Update.Version, StringFormat='Get build {0}', FallbackValue=''}"
                            Command="{Binding Updates.OpenPageCommand}" IsVisible="{Binding Updates.CanOnlyOpenPage}"
                            Margin="12,0,0,0" Padding="8,2"
                            ToolTip.Tip="Open the new build's page on GitHub" />
                </StackPanel>
                <Button Grid.Column="2" Content="Undo last apply" Command="{Binding UndoLastApplyCommand}"
                        IsVisible="{Binding HasLastApply}" Margin="12,0,0,0" Padding="8,2"
                        ToolTip.Tip="Put back every file the last Apply replaced" />
                <TextBlock Grid.Column="3" Text="{Binding BuildInfoText}" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" TabStripPlacement="Left" Padding="16,12">

            <!-- ============================================================ Games -->
            <TabItem Header="Games">
                <Grid ColumnDefinitions="*,380" RowDefinitions="Auto,*,Auto">

                    <!-- Toolbar -->
                    <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Classes="accent" Margin="0,0,6,6"
                                ToolTip.Tip="Look for games and the runtimes they carry (F5)" />
                        <Button Content="+ Add Game" Command="{Binding AddGameCommand}" Margin="0,0,6,6"
                                ToolTip.Tip="Add a game by choosing the folder it is installed in" />
                        <Button Content="+ Add Folder" Command="{Binding AddFolderCommand}" Margin="0,0,6,6"
                                ToolTip.Tip="Add a folder that holds games, one per subfolder, such as where repacks are installed" />
                        <Button Content="⬆ Newest" Command="{Binding ChooseNewestCommand}" Margin="0,0,6,6"
                                ToolTip.Tip="Choose the newest version you hold of every runtime in every game. Nothing changes until Apply." />
                        <Button Content="Import…" Command="{Binding BeginImportCommand}" Margin="0,0,6,6"
                                ToolTip.Tip="Add a runtime file you got elsewhere to the collection. You can also drop a .dll on the window." />
                        <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,6,6"
                                ToolTip.Tip="Undo the last change to the selected game (Ctrl+Z)" />
                        <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,6,6"
                                ToolTip.Tip="Redo the last undo on the selected game (Ctrl+Y)" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,6,6"
                                IsVisible="{Binding IsBusy}" />
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" Watermark="Search games (Ctrl+F)" Width="240" Margin="12,0,6,6"
                                 AutomationProperties.Name="Search games" />
                        <ToggleButton IsChecked="{Binding ShowOnlyUpdates}" Margin="0,0,6,6"
                                      Content="{Binding UpdatableCount, StringFormat='Needs update ({0})'}"
                                      ToolTip.Tip="Show only games you hold a newer version for" />
                    </WrapPanel>

                    <!-- Cover grid, one section per library -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <TextBlock Classes="muted" Margin="0,24" IsVisible="{Binding !HasGames}"
                                       Text="No games yet. Press Refresh to look for them, or + Add Game to add one by its folder." />
                            <TextBlock Classes="muted" Margin="0,24" IsVisible="{Binding IsSearchMissingEverything}"
                                       Text="No game matches the search or filter." />

                            <ItemsControl ItemsSource="{Binding GameGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameGroup">
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Library}" Classes="heading" />
                                            <ListBox Classes="covers" ItemsSource="{Binding Games}"
                                                     SelectionChanged="OnGameSelected"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GameRow">
                                                        <StackPanel Width="140" ToolTip.Tip="{Binding InstallPath}" Background="Transparent">
                                                            <StackPanel.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Open game folder" Click="OnOpenFolder" />
                                                                    <MenuItem Header="Undo last change" Click="OnUndoGame" />
                                                                    <MenuItem Header="Restore original files" Click="OnRestoreGame" />
                                                                    <Separator />
                                                                    <MenuItem Header="Hide" Click="OnHideGame" />
                                                                    <MenuItem Header="Remove from list" Click="OnRemoveGame"
                                                                              IsVisible="{Binding IsAddedByHand}" />
                                                                </ContextMenu>
                                                            </StackPanel.ContextMenu>
                                                            <Panel Height="210">
                                                                <Border CornerRadius="6" ClipToBounds="True"
                                                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                                    <Panel>
                                                                        <TextBlock Text="{Binding Initial}" FontSize="48" Opacity="0.5"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   IsVisible="{Binding !HasPoster}" />
                                                                        <!-- Whole, not cropped: a capsule is the card's own 2:3 shape, and a wide header kept whole still shows its title. -->
                                                                        <Image Source="{Binding PosterPath, Converter={x:Static local:MainWindow.PosterImage}}"
                                                                               Stretch="Uniform" />
                                                                    </Panel>
                                                                </Border>
                                                            </Panel>
                                                            <TextBlock Text="{Binding GameName}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                                            <ItemsControl ItemsSource="{Binding RuntimeVersions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The selected game -->
                    <Border Classes="pane" Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Padding="16" CornerRadius="8">
                        <ScrollViewer>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Classes="muted" IsVisible="{Binding !HasDetailPanel}"
                                           Text="Choose a game to see the runtimes it carries and pick versions for them." />

                                <StackPanel IsVisible="{Binding HasDetailPanel}">
                                    <TextBlock Text="{Binding SelectedGame.GameName, FallbackValue=''}" Classes="heading" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedGame.LibraryName, FallbackValue=''}" Classes="muted" />
                                    <TextBlock Text="{Binding SelectedGame.InstallPath, FallbackValue=''}" Classes="muted" FontSize="12" Margin="0,2,0,12" />

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6" />
                                        <Button Content="Restore original" Command="{Binding RestoreOriginalCommand}" Margin="0,0,6,6"
                                                ToolTip.Tip="Undo every change made to this game, putting back the files it shipped with" />
                                        <Button Content="Hide" Command="{Binding HideGameCommand}" Margin="0,0,6,6"
                                                ToolTip.Tip="Take this game out of the grid and out of ⬆ Newest. Bring it back from Settings." />
                                        <Button Content="Remove from list" Command="{Binding RemoveGameCommand}" Margin="0,0,6,6"
                                                IsVisible="{Binding SelectedGame.IsAddedByHand, FallbackValue=False}"
                                                ToolTip.Tip="Take this hand-added game off the list. Its files are not touched." />
                                    </WrapPanel>

                                    <ItemsControl ItemsSource="{Binding SelectedGame.Choices, FallbackValue={x:Null}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RuntimeChoice">
                                                <StackPanel Margin="0,0,0,12" IsVisible="{Binding IsAvailable}">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                              HorizontalAlignment="Stretch" Margin="0,4,0,2"
                                                              PlaceholderText="Choose a version"
                                                              AutomationProperties.Name="{Binding Label}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RuntimeOption">
                                                                <TextBlock Text="{Binding Label}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding CurrentText, StringFormat='Now: {0}'}" Classes="muted" FontSize="12" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- What Apply will do, and an import waiting to be confirmed -->
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <StackPanel IsVisible="{Binding HasImportPreview}" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ImportPreviewText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{Binding ImportConfirmLabel}" Command="{Binding ConfirmImportCommand}" Margin="0,0,6,0" />
                                <Button Content="Discard" Command="{Binding DiscardImportCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Preview}" IsVisible="{Binding HasPreview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewLine">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding HasPreview}">
                            <Button Content="Apply" Command="{Binding ApplySwapCommand}" Classes="accent"
                                    ToolTip.Tip="Replace the files listed above (Ctrl+Enter)" />
                            <TextBlock Text="{Binding PendingChangeCount, StringFormat='{}{0} version(s) chosen'}"
                                       Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Download -->
            <TabItem Header="Download">
                <ScrollViewer>
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Download" Classes="heading" />
                        <TextBlock Classes="muted" Margin="0,0,0,12"
                                   Text="Straight from NVIDIA, AMD and Intel's own release repositories. Only files signed by their vendor are added." />

                        <Button Content="Get newest for my games" Command="{Binding Downloads.GetNewestForGamesCommand}"
                                Classes="accent" Margin="0,0,0,12"
                                ToolTip.Tip="Download the newest version of every runtime your games carry" />

                        <TextBlock Text="Or choose one" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Downloads.Kinds}" SelectedItem="{Binding Downloads.SelectedKind}"
                                      Width="200" PlaceholderText="Runtime" AutomationProperties.Name="Runtime to download">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DownloadKind">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding Downloads.Releases}" SelectedItem="{Binding Downloads.SelectedRelease}"
                                      Width="140" Margin="6,0,0,0" AutomationProperties.Name="Release to download" />
                            <Button Content="Download" Command="{Binding Downloads.DownloadSelectedCommand}" Margin="6,0,0,0" />
                            <Button Content="Stop" Command="{Binding Downloads.StopCommand}" Margin="6,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding Downloads.StatusText}" Classes="muted" Margin="0,12,0,0" />
                        <ProgressBar Value="{Binding Downloads.Progress}" Maximum="100" Height="6" Margin="0,4,0,0"
                                     IsVisible="{Binding Downloads.IsBusy}" />

                        <TextBlock Text="Versions you hold" Classes="heading" Margin="0,28,0,4" />
                        <TextBlock Text="{Binding LibrarySummary}" Classes="muted" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding LibraryKindOptions}" SelectedItem="{Binding LibraryKind}"
                                  Width="200" Margin="0,0,0,8" AutomationProperties.Name="Filter by runtime">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryKindOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ItemsControl ItemsSource="{Binding LibraryEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryEntry">
                                    <Grid ColumnDefinitions="160,140,*" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontFamily="Consolas" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding TrustText}" FontSize="12" />
                                            <TextBlock Text="{Binding UsageText}" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Diagnostics -->
            <TabItem Header="Diagnostics" IsSelected="{Binding IsDiagnosticsOpen}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Diagnostics" Classes="heading" />
                        <TextBlock Text="{Binding Diagnostics.StatusText}" Classes="muted" Margin="0,0,0,4" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" MaxWidth="400" HorizontalAlignment="Left"
                                     IsVisible="{Binding Diagnostics.IsRunning}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Run again" Command="{Binding Diagnostics.RunCommand}" Margin="0,0,6,0"
                                    ToolTip.Tip="Scan your games again, then run every check" />
                            <Button Content="Copy report" Command="{Binding Diagnostics.CopyCommand}" Margin="0,0,6,0" />
                            <Button Content="Export…" Command="{Binding Diagnostics.ExportCommand}"
                                    ToolTip.Tip="Save the report, logs, settings, collection and history as a zip" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer>
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Environment" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Diagnostics.Environment}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diag:DiagnosticFact">
                                        <Grid ColumnDefinitions="160,*">
                                            <TextBlock Text="{Binding Name}" Classes="muted" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Checks" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Diagnostics.Checks}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diag:DiagnosticCheck">
                                        <Grid ColumnDefinitions="24,*" Margin="0,0,0,6" ToolTip.Tip="{Binding Detail}">
                                            <TextBlock Text="{Binding Glyph}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Area}" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Errors and crashes" FontWeight="SemiBold" Margin="0,0,0,4"
                                       IsVisible="{Binding Diagnostics.HasRecentErrors}" />
                            <ItemsControl ItemsSource="{Binding Diagnostics.RecentErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="log:LogEntry">
                                        <StackPanel Margin="0,0,0,6" ToolTip.Tip="{Binding ExceptionStackTrace}">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Classes="muted" FontSize="12">
                                                <Run Text="{Binding Timestamp.LocalDateTime, StringFormat='{}{0:g}', Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Category, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ExceptionMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ Settings -->
            <TabItem Header="Settings">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" Classes="heading" />
                    <CheckBox Content="Magic background" IsChecked="{Binding MagicBackground}" Margin="0,0,0,4"
                              ToolTip.Tip="A slowly turning magic circle behind the window, in the icon's colours" />
                    <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,12"
                               Text="Turn off for a plain window that follows your Windows light or dark setting." />
                    <CheckBox Content="Allow untrusted runtimes" IsChecked="{Binding AllowUntrustedRuntimes}" Margin="0,0,0,4" />
                    <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,12"
                               Text="Import files that are not signed by NVIDIA, AMD or Intel without asking each time. A warning is still shown before one goes into a game." />
                    <TextBlock Text="Undo steps kept per game" Margin="0,0,0,4" />
                    <NumericUpDown Value="{Binding MaxHistoryPerGame}" Minimum="1" Maximum="1000" Increment="1"
                                   FormatString="0" Width="160" HorizontalAlignment="Left"
                                   AutomationProperties.Name="Undo steps kept per game" />

                    <TextBlock Text="Game folders" FontWeight="SemiBold" Margin="0,24,0,4" />
                    <TextBlock Classes="muted" FontSize="12" Margin="0,0,0,8"
                               Text="Each subfolder of these is listed as a game on every refresh, so a game added later shows up by itself." />
                    <ItemsControl ItemsSource="{Binding GameFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Remove" Margin="8,0,0,0"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveFolderCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Stop listing this folder's games. Nothing in it is touched." />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Add Folder" Command="{Binding AddFolderCommand}" Margin="0,4,0,0" />

                    <TextBlock Text="Hidden games" FontWeight="SemiBold" Margin="0,24,0,4" IsVisible="{Binding HasHiddenGames}" />
                    <ItemsControl ItemsSource="{Binding HiddenGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameRow">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding GameName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Show" Margin="8,0,0,0"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UnhideGameCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,24,0,4" />
                    <CheckBox Content="Check for updates when Kronos Reborn starts" IsChecked="{Binding CheckForUpdates}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Check now" Command="{Binding Updates.CheckCommand}" />
                        <Button Content="{Binding Updates.Update.Version, StringFormat='Install build {0}', FallbackValue=''}"
                                Command="{Binding Updates.InstallCommand}" IsVisible="{Binding Updates.CanInstall}"
                                Classes="accent" Margin="6,0,0,0" />
                        <Button Content="Open release page" Command="{Binding Updates.OpenPageCommand}"
                                IsVisible="{Binding Updates.HasUpdate}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Updates.StatusText}" Classes="muted" Margin="0,6,0,0" />
                    <ProgressBar Maximum="100" Value="{Binding Updates.Progress, Mode=OneWay}" Height="6" Margin="0,4,0,0"
                                 IsVisible="{Binding Updates.IsBusy}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Panel>
</Window>
