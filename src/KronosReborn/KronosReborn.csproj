<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
    Avalonia rather than WPF, so the same window can run on Linux once the core can. The target is
    plain net10.0 for that reason; nothing here is Windows-only.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>

    <!--
    RootNamespace and AssemblyName are kept equal deliberately. Embedded resource names are derived
    from the root namespace, so if the two drift apart a resource looked up by name silently stops
    being found.
    -->
    <AssemblyName>KronosReborn</AssemblyName>
    <RootNamespace>KronosReborn</RootNamespace>

    <!-- The name shown to users. Distinct from the assembly name, which cannot contain a space. -->
    <Product>Kronos Reborn</Product>
    <Company>Kronos Reborn</Company>
    <Authors>Kronos Reborn contributors</Authors>

    <!-- Bindings are checked when the XAML compiles, so a misspelt property fails the build. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Store discovery behind #if WINDOWS reads the registry, which exists only there. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KronosReborn.Core\KronosReborn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>

</Project>
