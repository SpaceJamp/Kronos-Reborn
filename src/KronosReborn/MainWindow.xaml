<Window x:Class="KronosReborn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Kronos Reborn"
        Height="480" Width="720"
        WindowStartupLocation="CenterScreen">
    <!--
    The window is a placeholder. It exists to prove the build produces a launchable application and,
    more usefully, to prove the build metadata below really made it into the assembly: the version,
    commit hash and build date shown here are read from metadata injected by the build, not compiled
    into the source.
    -->
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Kronos Reborn" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,0" Opacity="0.7"
                   Text="Scaffolding. No features yet." />
        <TextBlock Margin="0,24,0,0" Text="{Binding VersionText}" />
        <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                   Text="{Binding BuildText}" />
    </StackPanel>
</Window>
