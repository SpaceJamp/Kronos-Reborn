<Window x:Class="KronosReborn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KronosReborn"
        xmlns:ui="clr-namespace:KronosReborn.UI"
        mc:Ignorable="d"
        Title="Kronos Reborn"
        Height="760" Width="1600"
        MinHeight="500" MinWidth="1600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        d:DataContext="{d:DesignInstance Type=ui:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ui:InverseBooleanConverter x:Key="InverseBool" />
        <ui:BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            The cell used for every runtime column in the game list: this game's version picker for
            one runtime, or nothing at all where the game does not carry that runtime.

            A DataTemplate rather than markup repeated five times, so the five columns cannot drift
            apart — a change to how a version is chosen has to apply to DLSS and XeSS equally, and
            there is only one copy of it to get wrong.
            -->
        <DataTemplate x:Key="RuntimePickerTemplate">
            <DataTemplate.Triggers>
                <!--
                    Availability rather than a null Content. Every row binds to a real choice object so
                    that no binding silently resolves to nothing, which leaves the cell looking as
                    though it were working.
                    -->
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>

            <StackPanel>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected}"
                          MinWidth="96"
                          FontFamily="Consolas"
                          FontSize="{StaticResource FontSizeSmall}"
                          ToolTip="{Binding Label}" />

                <!--
                    What the choice would do, under the picker it applies to.

                    A dropdown left on the version already installed does nothing at all, and saying
                    so is better than a user pressing Apply and being told nothing happened.
                    -->
                <TextBlock Text="{Binding StatusText}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,1,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Toolbar -->
            <RowDefinition Height="*" />     <!-- Game list -->
            <RowDefinition Height="Auto" />  <!-- Runtime bar -->
            <RowDefinition Height="Auto" />  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <!-- Title area -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Kronos Reborn" Style="{StaticResource TitleStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SubtitleStyle}" />
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,12,0" />

                <!-- Refresh button -->
                <Button Content="Refresh"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Scan libraries and detect runtimes (F5)" />

                <!-- Group toggle -->
                <Button Content="{Binding GroupModeText}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ToggleGroupCommand}"
                        ToolTip="Toggle grouping by library" />

                <!--
                Search. Filters the list as it is typed, so a library of a few hundred games
                can be narrowed without scrolling.

                The icon is a Grid overlay rather than a sibling with a negative margin: in a
                horizontal StackPanel a negative left margin pulls the next item back over this one,
                which put the magnifier on top of the text at the right-hand end of the box.
                -->
                <Grid Width="200"
                      Height="26"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Padding="22,4,8,4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter by game name" />

                    <TextBlock Text="🔍"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               IsHitTestVisible="False"
                               FontSize="11" />
                </Grid>

                <!-- Theme toggle -->
                <Button Content="🌓"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle light/dark theme"
                        FontSize="16"
                        Padding="10,4" />

                <!-- Spacer -->
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,0" VerticalAlignment="Stretch" />

                <!-- Selected count -->
                <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                           Style="{StaticResource SubtitleStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,12,0" />

                <!--
        The selected game's detail panel.

        The pickers live here rather than in the list because a list row is the wrong place for a
        control that changes something: it makes every row look editable, and with five runtime
        columns it leaves no room for the game name. Here the game being changed is named, its install
        path is shown, and each runtime has its own dropdown beneath its own label — so which of the
        three DLSS parts a version belongs to is stated on the control that will install it.

        Inline rather than a dialog, which the specification asks for: this is a question that can be
        answered on the main window, so it is not put behind a modal.
        -->
        <Border Grid.Row="1"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,16,16,16"
                Padding="16"
                Visibility="{Binding ShowDetailPanel, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedGame.GameName}"
                           Style="{StaticResource TitleStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding SelectedGame.InstallPath}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,12" />

                <!--
                Each runtime with its own label over its own dropdown. Two columns, because there are
                five runtimes and a single column of five controls pushes the bottom off the window.
                -->
                <ItemsControl ItemsSource="{Binding SelectedGame.Choices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="150"
                                        Margin="0,0,10,10"
                                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Margin="0,0,0,2" />

                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource RuntimePickerTemplate}" />

                                <TextBlock Text="{Binding CurrentText}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Settings panel -->
        <Border Grid.Row="1"
                Width="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,16,16,16"
                Padding="16"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource TitleStyle}" Margin="0,0,0,12" />

                <CheckBox Content="Allow untrusted runtimes"
                          IsChecked="{Binding AllowUntrustedRuntimes, Mode=TwoWay}"
                          Margin="0,0,0,8"
                          ToolTip="Accept runtime DLLs without valid signatures" />

                <TextBlock Text="Max history per game" Margin="0,4,0,2" />
                <TextBox Text="{Binding MaxHistoryPerGame, Mode=TwoWay}"
                         Width="80"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,8" />

                <CheckBox Content="Group by library"
                          IsChecked="{Binding GroupByLibrary, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <Button Content="Close"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ToggleSettingsCommand}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- Games / version library -->
                <Button Content="{Binding AreaText}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ToggleAreaCommand}"
                        Margin="12,0,0,0"
                        ToolTip="Switch between your games and the versions you hold" />

                <!-- Settings -->
                <Button Content="⚙ Settings"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Border>

        <!-- Game List -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundBrush}"
                Margin="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
            <!--
            The list and the poster grid are both here and one is hidden, rather than one of them being
            rebuilt when the view changes. Rebuilding a GridView on every toggle throws away the column
            widths the user has dragged, which is a small thing that is very annoying if it happens
            every time you press the button.
            -->
            <ListView x:Name="GameListView"
                      ItemsSource="{Binding Games, Mode=OneWay}"
                        SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                      SelectionMode="Extended"
                      Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView x:Name="GameGridView">
                        <!-- Status column -->
                        <GridViewColumn Width="40">
                            <GridViewColumn.Header>
                                <TextBlock Text="" ToolTip="Status" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}"
                                                 Style="{StaticResource StatusIndicatorStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!--
                        Poster.

                        Steam has already downloaded cover art for every app it knows, so this is
                        read from its own cache rather than fetched. A game with no cached art shows
                        its initial instead: artwork is a nicety and no game is listed without one.

                        The poster is kept in the same cell as the game name, so a game is
                        one unit to look at rather than a thumbnail beside a row of text.
                        -->
                        <GridViewColumn Header="Game" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Sized so the whole row still fits the window at its
                                            minimum width. Steam's artwork is up to 600x900, and
                                            showing it at anything near its own size pushes the
                                            runtime columns off the right edge and forces the list
                                            to scroll sideways.
                                            -->
                                            <Grid Grid.Column="0" Width="32" Height="48"
                                                  Margin="0,2,8,2">
                                            <Border Background="{DynamicResource BackgroundBrush}"
                                                    CornerRadius="3"
                                                    Visibility="{Binding HasPoster, Converter={StaticResource InverseBool}}">
                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="15"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <Image Source="{Binding PosterPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasPoster, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding InstallPath}" />
                                            <TextBlock Text=" (missing)"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       FontStyle="Italic"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Library -->
                        <GridViewColumn Header="Library" Width="130"
                                        DisplayMemberBinding="{Binding LibraryName}" />

                        <!--
                        Versions, read-only.

                        The pickers for these live in the selected game's panel rather than here, and
                        that is deliberate: a control in every row would make the whole list look
                        editable, and two controls showing the same value is a defect however well
                        they agree. What the list shows is what each game runs, which is what you
                        compare rows by; what you can change is in the panel, on one named game.
                        -->
                        <GridViewColumn Header="DLSS" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DlssChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="DLSS FG" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DlssGChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="DLSS RR" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DlssRChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="FSR" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FsrChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="FSR VK" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FsrVkChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="XeSS" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding XessChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="XeSS FG" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding XessFgChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="XeSS DX11" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding XessDx11Choice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="XeLL" Width="104">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding XellChoice.CurrentText, TargetNullValue='—'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- Last Changed -->
                        <GridViewColumn Header="Last Changed" Width="110"
                                        DisplayMemberBinding="{Binding LastChangedText}" />
                    </GridView>
                </ListView.View>

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeNormal}"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Padding="4,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True"
                                                      Background="{DynamicResource SurfaceBrush}"
                                                      BorderBrush="{DynamicResource BorderBrush}"
                                                      BorderThickness="0,0,0,1"
                                                      Margin="0,8,0,0">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Padding="4,4" />
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

</Grid>
        </Border>

        <!--
        The version library.

        What the collection actually holds, which is a question the game list cannot answer: the list
        says what each game runs and the pickers say what could go into one game, but nothing said what
        was available in total, where a version came from, or whether it could be trusted. A version
        three games already run is one known to work on this machine, which is why the card says so.

        Newest first, compared by number rather than as text: text ordering puts 310.9.1 before 310.2.1,
        which makes the older build look like the newer one.
        -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundBrush}"
                Margin="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding ShowingLibrary, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,0">
                    <TextBlock Text="{Binding LibrarySummary}"
                               Style="{StaticResource SubtitleStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!--
                    Filter by runtime. Leaving it unset shows everything, which is what a first visit
                    should show rather than an empty library because nothing had been chosen yet.
                    -->
                    <ComboBox ItemsSource="{Binding LibraryKindOptions}"
                              SelectedItem="{Binding LibraryKind}"
                              MinWidth="140"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="8,8,8,0">
                    <ItemsControl ItemsSource="{Binding LibraryEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250"
                                        Margin="0,0,8,8"
                                        Padding="12"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       Style="{StaticResource SubtitleStyle}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Version}"
                                                       FontFamily="Consolas"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding TrustText}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0" />

                                        <TextBlock Text="{Binding UsageText}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Margin="0,2,0,0" />

                                        <TextBlock Text="{Binding SourceText}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Empty state overlay -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                Margin="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasGames, Converter={StaticResource InverseBool}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="📂" FontSize="64" HorizontalAlignment="Center" />
                <TextBlock Text="No games found"
                           Style="{StaticResource TitleStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8" />
                <TextBlock Text="Click Refresh to scan your Steam libraries for games and runtime DLLs."
                           Style="{StaticResource SubtitleStyle}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400" />
                <Button Content="Refresh Now"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,24,0,0"
                        Padding="24,10" />
            </StackPanel>
        </Border>

        <!--
            Runtime bar: the swap surface.

            Inline rather than a dialog, because the specification asks for a single window and says
            not to use a modal dialog for a question that can be asked inline. Selecting a game fills
            the picker with the versions the collection holds for that game; Preview says what would
            change before anything does, and Apply is only enabled once a preview exists.
        -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedGame.GameName, FallbackValue='No game selected'}"
                               Style="{StaticResource SubtitleStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <!--
                    No picker here any more.

                    The version choices live in the game's own row, one column per runtime, because
                    that is what lets a change be made to several games and then seen as a whole
                    before anything is written. A picker for one selected game could only ever change
                    one thing at a time, and this bar had become the reason the list could not be used
                    the way the list is for.
                    -->
                    <TextBlock Text="{Binding PendingChangeCount, StringFormat='{}{0} version(s) chosen'}"
                               Style="{StaticResource SubtitleStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Preview"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding PreviewSwapCommand}"
                            Margin="4,0,0,0" />

                    <Button Content="Apply"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ApplySwapCommand}"
                            Margin="4,0,0,0"
                            IsEnabled="{Binding HasPreview}" />

                    <Button Content="Undo"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding UndoCommand}"
                            Margin="4,0,0,0" />

                    <Button x:Name="ImportButton" Content="Import…"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding BeginImportCommand}"
                            Margin="4,0,0,0"
                            ToolTip="Add a runtime version you obtained elsewhere to the collection" />

                    <Button Content="Cancel"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Preview and problems, R37/R63: warnings and every failure are shown, never dropped. -->
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            MaxWidth="460">
                    <ItemsControl ItemsSource="{Binding Preview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}"
                                           Style="{StaticResource SubtitleStyle}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                    What importing a file would do. Shown before anything is copied, because R16
                    requires the signature to be checked first and the user asked about an untrusted
                    file before it is accepted.
                    -->
                    <StackPanel Visibility="{Binding HasImportPreview, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,8,0,0">
                        <TextBlock Text="{Binding ImportPreviewText}"
                                   Style="{StaticResource SubtitleStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{Binding ImportConfirmLabel}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ConfirmImportCommand}" />
                            <Button Content="Not now"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding DiscardImportCommand}"
                                    Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Problems}"
                                  Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OneLine}"
                                           Style="{StaticResource SubtitleStyle}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource StatusTextStyle}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="{Binding BuildInfoText}"
                               Style="{StaticResource BuildInfoStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
