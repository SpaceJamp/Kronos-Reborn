<Window x:Class="KronosReborn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KronosReborn"
        xmlns:ui="clr-namespace:KronosReborn.UI"
        mc:Ignorable="d"
        Title="Kronos Reborn"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        d:DataContext="{d:DesignInstance Type=ui:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <ui:InverseBooleanConverter x:Key="InverseBool" />
        <ui:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Toolbar -->
            <RowDefinition Height="*" />     <!-- Game list -->
            <RowDefinition Height="Auto" />  <!-- Runtime bar -->
            <RowDefinition Height="Auto" />  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <!-- Title area -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Kronos Reborn" Style="{StaticResource TitleStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SubtitleStyle}" />
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,12,0" />

                <!-- Refresh button -->
                <Button Content="Refresh"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Scan libraries and detect runtimes (F5)" />

                <!-- Group toggle -->
                <Button Content="{Binding GroupModeText}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ToggleGroupCommand}"
                        ToolTip="Toggle grouping by library" />

                <!-- Theme toggle -->
                <Button Content="🌓"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle light/dark theme"
                        FontSize="16"
                        Padding="10,4" />

                <!-- Spacer -->
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,0" VerticalAlignment="Stretch" />

                <!-- Selected count -->
                <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                           Style="{StaticResource SubtitleStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,12,0" />

                <!-- Settings -->
                <Button Content="⚙ Settings"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Border>

        <!-- Game List -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundBrush}"
                Margin="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ListView x:Name="GameListView"
                      ItemsSource="{Binding Games, Mode=OneWay}"
                        SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView x:Name="GameGridView">
                        <!-- Status column -->
                        <GridViewColumn Width="40">
                            <GridViewColumn.Header>
                                <TextBlock Text="" ToolTip="Status" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}"
                                                 Style="{StaticResource StatusIndicatorStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!--
                        Poster.

                        Steam has already downloaded cover art for every app it knows, so this is
                        read from its own cache rather than fetched. A game with no cached art shows
                        its initial instead: artwork is a nicety and no game is listed without one.

                        The poster is kept in the same cell as the game name, so a game is
                        one unit to look at rather than a thumbnail beside a row of text.
                        -->
                        <GridViewColumn Header="Game" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Sized so the whole row still fits the window at its
                                            minimum width. Steam's artwork is up to 600x900, and
                                            showing it at anything near its own size pushes the
                                            runtime columns off the right edge and forces the list
                                            to scroll sideways.
                                            -->
                                            <Grid Grid.Column="0" Width="32" Height="48"
                                                  Margin="0,2,8,2">
                                            <Border Background="{DynamicResource BackgroundBrush}"
                                                    CornerRadius="3"
                                                    Visibility="{Binding HasPoster, Converter={StaticResource InverseBool}}">
                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="15"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <Image Source="{Binding PosterPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasPoster, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding InstallPath}" />
                                            <TextBlock Text=" (missing)"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       FontStyle="Italic"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Library -->
                        <GridViewColumn Header="Library" Width="130"
                                        DisplayMemberBinding="{Binding LibraryName}" />

                        <!-- DLSS -->
                        <GridViewColumn Header="DLSS" Width="92">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DlssVersion, TargetNullValue='—'}"
                                                   Foreground="{Binding DlssVersion, Converter={StaticResource StringToBrush}, ConverterParameter=HasValue}"
                                                   FontFamily="Consolas" />
                                        <TextBlock Text=" FG"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasDlssG, Converter={StaticResource BoolToVisibility}}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Text=" RR"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasDlssR, Converter={StaticResource BoolToVisibility}}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- FSR -->
                        <GridViewColumn Header="FSR" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FsrVersion, TargetNullValue='—'}"
                                               Foreground="{Binding FsrVersion, Converter={StaticResource StringToBrush}, ConverterParameter=HasValue}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- XeSS -->
                        <GridViewColumn Header="XeSS" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding XessVersion, TargetNullValue='—'}"
                                               Foreground="{Binding XessVersion, Converter={StaticResource StringToBrush}, ConverterParameter=HasValue}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Last Changed -->
                        <GridViewColumn Header="Last Changed" Width="120"
                                        DisplayMemberBinding="{Binding LastChangedText}" />
                    </GridView>
                </ListView.View>

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeNormal}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Padding="4,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True"
                                                      Background="{DynamicResource SurfaceBrush}"
                                                      BorderBrush="{DynamicResource BorderBrush}"
                                                      BorderThickness="0,0,0,1"
                                                      Margin="0,8,0,0">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Padding="4,4" />
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>

        <!-- Empty state overlay -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                Margin="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasGames, Converter={StaticResource InverseBool}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="No games found"
                           Style="{StaticResource TitleStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8" />
                <TextBlock Text="Click Refresh to scan your Steam libraries for games and runtime DLLs."
                           Style="{StaticResource SubtitleStyle}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400" />
                <Button Content="Refresh Now"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,24,0,0"
                        Padding="24,10" />
            </StackPanel>
        </Border>

        <!--
            Runtime bar: the swap surface.

            Inline rather than a dialog, because the specification asks for a single window and says
            not to use a modal dialog for a question that can be asked inline. Selecting a game fills
            the picker with the versions the collection holds for that game; Preview says what would
            change before anything does, and Apply is only enabled once a preview exists.
        -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedGame.GameName, FallbackValue='No game selected'}"
                               Style="{StaticResource SubtitleStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <!--
                    One picker per runtime, because DLSS, DLSS Frame Generation and DLSS Ray
                    Reconstruction are three separate things the user chooses between separately.

                    A single flat list of every version of every runtime cannot express that: it shows
                    "310.2.1" three times over with only the surrounding lines saying which is which,
                    and picking the wrong line installs the wrong DLL. Here each runtime has its own
                    row and its own versions, so a choice is visibly a choice about that runtime and
                    nothing else is installed alongside it.
                    -->
                    <ItemsControl ItemsSource="{Binding RuntimeGroups}"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding HasRuntimeGroups, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource SubtitleStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               ToolTip="{Binding CurrentText}" />

                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding Selected}"
                                              DisplayMemberPath="Label"
                                              MinWidth="150"
                                              VerticalAlignment="Center"
                                              ToolTip="Versions of this runtime the collection holds" />

                                    <TextBlock Text="{Binding StatusText}"
                                               Style="{StaticResource SubtitleStyle}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               MinWidth="120" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Preview"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding PreviewSwapCommand}"
                            Margin="4,0,0,0" />

                    <Button Content="Apply"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ApplySwapCommand}"
                            Margin="4,0,0,0"
                            IsEnabled="{Binding HasPreview}" />

                    <Button Content="Undo"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding UndoCommand}"
                            Margin="4,0,0,0" />

                    <Button x:Name="ImportButton" Content="Import…"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding BeginImportCommand}"
                            Margin="4,0,0,0"
                            ToolTip="Add a runtime version you obtained elsewhere to the collection" />

                    <Button Content="Cancel"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Preview and problems, R37/R63: warnings and every failure are shown, never dropped. -->
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            MaxWidth="460">
                    <ItemsControl ItemsSource="{Binding Preview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}"
                                           Style="{StaticResource SubtitleStyle}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                    What importing a file would do. Shown before anything is copied, because R16
                    requires the signature to be checked first and the user asked about an untrusted
                    file before it is accepted.
                    -->
                    <StackPanel Visibility="{Binding HasImportPreview, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,8,0,0">
                        <TextBlock Text="{Binding ImportPreviewText}"
                                   Style="{StaticResource SubtitleStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{Binding ImportConfirmLabel}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ConfirmImportCommand}" />
                            <Button Content="Not now"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding DiscardImportCommand}"
                                    Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Problems}"
                                  Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OneLine}"
                                           Style="{StaticResource SubtitleStyle}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource StatusTextStyle}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="{Binding BuildInfoText}"
                               Style="{StaticResource BuildInfoStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>