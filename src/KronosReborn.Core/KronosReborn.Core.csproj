<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KronosReborn</RootNamespace>
    <AssemblyName>KronosReborn.Core</AssemblyName>
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Shared source: compile the same files as the WPF app, excluding WPF-specific ones -->
  <ItemGroup>
    <Compile Include="..\KronosReborn\Data\**\*.cs" />
    <Compile Include="..\KronosReborn\UI\PortableViewModels.cs" />
    <Compile Include="..\KronosReborn\UI\ThemeMode.cs" />
  </ItemGroup>

  <!-- Windows-only defines -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Suppress platform-specific analyzer warnings -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KronosReborn.Tests" />
  </ItemGroup>
</Project>