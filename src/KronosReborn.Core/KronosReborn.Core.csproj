<Project Sdk="Microsoft.NET.Sdk">
  <!--
  Everything that is not a window: discovery, swapping, persistence, downloads and the view-model
  types the interface binds to. No UI framework, so the tests can use all of it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KronosReborn</RootNamespace>
    <AssemblyName>KronosReborn.Core</AssemblyName>
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Windows-only defines -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Suppress platform-specific analyzer warnings -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KronosReborn.Tests" />
    <InternalsVisibleTo Include="KronosReborn" />
  </ItemGroup>
</Project>
